# ─── This branch (claude/direct-viya-agents): NO RAM ────────────────
# The three agents are Claude agentic loops in this backend; business rules
# execute on SAS Intelligent Decisioning through the sas-mcp-server sidecar.

# Required — powers the three agents
ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-opus-4-8      # default

# ─── SAS Viya (consumed by the sas-mcp-server sidecar) ───────────────
# start.sh also accepts the mixed-case spellings (Viya_Endpoint, Client_ID,
# Viya_Refresh_token, SSL_Verify, Compute_Context_name, Scope_Enforce).
VIYA_ENDPOINT=https://your-viya-host
VIYA_REFRESH_TOKEN=eyJ...
CLIENT_ID=sas-mcp
SSL_VERIFY=false
COMPUTE_CONTEXT_NAME=SAS Job Execution compute context
SCOPE_ENFORCE=true

# ─── Decision flow (published from SAS Intelligent Decisioning to MAS) ──
#DECISION_MODULE_ID=decision_84173c15_4130_492c_811   # default
#DECISION_STEP_ID=execute                             # default

# ─── Advanced ────────────────────────────────────────────────────────
#SAS_MCP_URL=http://127.0.0.1:8134/mcp   # external sas-mcp-server instead of the sidecar
#SAS_MCP_API_KEY=...                     # its MCP_API_KEY (auto-generated for the sidecar)
