# ─── SAS Retrieval Agent Manager connection ──────────────────────────
# Base URL of the RAM API
RAM_API_URL=https://your-ram-host/SASRetrievalAgentManager/api/v1

# Set to false if your environment uses self-signed certificates
#RAM_VERIFY_SSL=true

# ─── Authentication ──────────────────────────────────────────────────
# Interactive sign-in: with only RAM_API_URL set, the UI shows a "Sign in"
# button. The backend auto-detects the deployment type:
#   • Standalone RAM (Keycloak)  → device code flow with PKCE against the
#     pre-configured public client (enter a short code on the verification page)
#   • Full SAS Viya (SASLogon)   → authorization code flow with the sas.cli
#     public client (log in — SSO included — then paste the displayed code)
# Either way the backend keeps the session alive with the refresh token.
#
# Defaults you can override if your deployment differs:
#RAM_AUTH_FLOW=device|code         # skip auto-detection
#RAM_CLIENT_ID=sas-ram-api         # Keycloak device-flow client
#RAM_REALM=sas-iot                 # Keycloak realm
#SAS_AUTH_CLIENT_ID=sas.cli        # Viya authorization-code client
#SAS_AUTH_CLIENT_SECRET=           # only if that client has a secret

# Option A: paste a static bearer token (expires per your policy — demos only)
#RAM_TOKEN=eyJhbGciOi...

# Option B: a registered OAuth client — the backend fetches + refreshes tokens
# itself, no interactive sign-in. On standalone RAM, create a Keycloak client
# with "Direct access grants" enabled and point SAS_LOGON_URL at the realm's
# token endpoint.
#SAS_CLIENT_ID=ram-chat-ui
#SAS_CLIENT_SECRET=secret          # omit for a public (secret-less) client
#SAS_USERNAME=AppAdmin             # password grant; omit for client_credentials
#SAS_PASSWORD=your-password
#SAS_LOGON_URL=https://your-ram-host/SASRetrievalAgentManager/auth/realms/sas-iot/protocol/openid-connect/token
# (On full SAS Viya, SAS_LOGON_URL defaults to https://host/SASLogon/oauth/token)

# ─── Query behavior ──────────────────────────────────────────────────
# Queries are submitted asynchronously and polled (avoids gateway 504s on
# slow agent runs). How long to wait for an answer, and the poll cadence:
#RAM_QUERY_TIMEOUT=600             # seconds (default 600)
#RAM_QUERY_POLL_INTERVAL=2         # seconds between polls (default 2)

# ─── Demo mode ───────────────────────────────────────────────────────
# Run the whole UI against an in-memory mock, no RAM needed
#RAM_MOCK=true

# ─── UI behavior ─────────────────────────────────────────────────────
# Public base URL of this UI (used to build /api/files/{id} links that the
# Document Processing agent's MCP container fetches for OCR). Set on Railway:
#PUBLIC_BASE_URL=https://your-ui-domain.up.railway.app

# Max characters of an attached text document inlined into a query. Some RAM
# deployments reject long query content (HTTP 500 on submit) — lower this if
# attaching documents errors:
#ATTACH_MAX_CHARS=8000
